<?php
$this->headScript()->appendFile($this->assetUrl('js/vocabulary-form.js', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'edit vocabularies');
$translate = $this->plugin('translate');
$form->prepare();
?>

<?php echo $this->pageTitle($translate($vocabulary->label()), 1, $translate('Vocabularies'), $translate('Edit')); ?>
<?php $this->trigger('view.edit.before'); ?>
<?php echo $this->form()->openTag($form); ?>
<div id="page-actions">
    <?php $this->trigger('view.edit.page_actions', ['resource' => $vocabulary]); ?>
    <?php // Its confirmation loads when asked for, as from the list: its counts take a while on a large installation. ?>
    <?php echo $this->hyperlink($translate('Delete'), '#', [
        'class' => 'delete button sidebar-content',
        'data-sidebar-selector' => '#delete',
        'data-sidebar-content-url' => $vocabulary->url('delete-confirm'),
    ]); ?>
    <?php // One page back, as core's Cancel goes: Edit opens from the vocabulary's page or the list. ?>
