# The tests' vocabulary as Omeka has it, in another form of its namespace
# URI: https for http.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix review: <https://example.org/review#> .

review:Thing a rdfs:Class ;
    rdfs:label "<i>stored class label</i>" ;
    rdfs:comment "<i>stored class comment</i>" .

review:name a rdf:Property ;
    rdfs:label "<i>stored property label</i>" ;
    rdfs:comment "<i>stored property comment</i>" .
