#. Vocabulary label for Dublin Core
msgid "Dublin Core"
msgstr "Dublin Core"

#. Vocabulary comment for Dublin Core
msgid "Basic resource metadata (DCMI Metadata Terms)"
msgstr "Podstawowe metadane zasobów (Terminy metadanych DCMI)"

#. Class label for Dublin Core:Agent
#. Class label for Friend of a Friend:Agent
msgid "Agent"
msgstr "Agent"

#. Class comment for Dublin Core:Agent
msgid "A resource that acts or has the power to act."
msgstr "Zasób, który działa lub ma moc działania."

#. Class label for Dublin Core:AgentClass
msgid "Agent Class"
msgstr "Klasa agenta"

#. Class comment for Dublin Core:AgentClass
msgid "A group of agents."
msgstr "Grupa agentów."

#. Class label for Dublin Core:BibliographicResource
msgid "Bibliographic Resource"
msgstr "Zasób bibliograficzny"

#. Class comment for Dublin Core:BibliographicResource
msgid "A book, article, or other documentary resource."
msgstr "Książka, artykuł lub inny zasób dokumentacyjny."

#. Class label for Dublin Core:FileFormat
msgid "File Format"
msgstr "Format pliku"

#. Class comment for Dublin Core:FileFormat
msgid "A digital resource format."
msgstr "Format zasobu cyfrowego."

#. Class label for Dublin Core:Frequency
msgid "Frequency"
msgstr "Częstotliwość"

#. Class comment for Dublin Core:Frequency
msgid "A rate at which something recurs."
msgstr "Wskaźnik, w jakim coś się powtarza."

#. Class label for Dublin Core:Jurisdiction
msgid "Jurisdiction"
msgstr "Jurysdykcja"

#. Class comment for Dublin Core:Jurisdiction
msgid "The extent or range of judicial, law enforcement, or other authority."
msgstr "Zakres lub obszar jurysdykcji, egzekwowania prawa lub innej władzy."

#. Class label for Dublin Core:LicenseDocument
msgid "License Document"
msgstr "Dokument licencyjny"

#. Class comment for Dublin Core:LicenseDocument
msgid ""
"A legal document giving official permission to do something with a Resource."
msgstr ""
"Dokument prawny udzielający oficjalnego zezwolenia na dokonanie czegoś z "
"zasobem."

#. Class label for Dublin Core:LinguisticSystem
msgid "Linguistic System"
msgstr "System językowy"

#. Class comment for Dublin Core:LinguisticSystem
msgid ""
"A system of signs, symbols, sounds, gestures, or rules used in "
"communication."
msgstr ""
"System znaków, symboli, dźwięków, gestów lub zasad używanych w komunikacji."

#. Class label for Dublin Core:Location
msgid "Location"
msgstr "Lokalizacja"

#. Class comment for Dublin Core:Location
msgid "A spatial region or named place."
msgstr "Obszar przestrzenny lub nazwana lokalizacja."

#. Class label for Dublin Core:LocationPeriodOrJurisdiction
msgid "Location, Period, or Jurisdiction"
msgstr "Lokalizacja, okres lub jurysdykcja"

#. Class comment for Dublin Core:LocationPeriodOrJurisdiction
msgid "A location, period of time, or jurisdiction."
msgstr "Miejsce, okres czasu lub jurysdykcja."

#. Class label for Dublin Core:MediaType
msgid "Media Type"
msgstr "Typ mediów"

#. Class comment for Dublin Core:MediaType
msgid "A file format or physical medium."
msgstr "Format pliku lub nośnik fizyczny."

#. Class label for Dublin Core:MediaTypeOrExtent
msgid "Media Type or Extent"
msgstr "Typ mediów lub zakres"

#. Class comment for Dublin Core:MediaTypeOrExtent
msgid "A media type or extent."
msgstr "Dowolny typ mediów lub zakres."

#. Class label for Dublin Core:MethodOfInstruction
msgid "Method of Instruction"
msgstr "Metoda nauczania"

#. Class comment for Dublin Core:MethodOfInstruction
msgid "A process that is used to engender knowledge, attitudes, and skills."
msgstr ""
"Proces, który jest używany do kształtowania wiedzy, postaw i umiejętności."

#. Class label for Dublin Core:MethodOfAccrual
msgid "Method of Accrual"
msgstr "Metoda memoriałowa"

#. Class comment for Dublin Core:MethodOfAccrual
msgid "A method by which resources are added to a collection."
msgstr "Metoda, za pomocą której zasoby są dodawane do kolekcji."

#. Class label for Dublin Core:PeriodOfTime
msgid "Period of Time"
msgstr "Okres czasu"

#. Class comment for Dublin Core:PeriodOfTime
msgid ""
"An interval of time that is named or defined by its start and end dates."
msgstr ""
"Interwał czasu, który jest nazwany lub zdefiniowany przez daty rozpoczęcia i"
" zakończenia."

#. Class label for Dublin Core:PhysicalMedium
msgid "Physical Medium"
msgstr "Medium fizyczne"

#. Class comment for Dublin Core:PhysicalMedium
msgid "A physical material or carrier."
msgstr "Fizyczny materiał lub nośnik."

#. Class label for Dublin Core:PhysicalResource
msgid "Physical Resource"
msgstr "Zasób fizyczny"

#. Class comment for Dublin Core:PhysicalResource
msgid "A material thing."
msgstr "Rzecz materialna."

#. Class label for Dublin Core:Policy
msgid "Policy"
msgstr "Polityka"

#. Class comment for Dublin Core:Policy
msgid ""
"A plan or course of action by an authority, intended to influence and "
"determine decisions, actions, and other matters."
msgstr ""
"Plan lub kurs działania podejmowany przez władzę, mający na celu wpływanie "
"na decyzje, działania i inne sprawy."

#. Class label for Dublin Core:ProvenanceStatement
msgid "Provenance Statement"
msgstr "Oświadczenie o pochodzeniu"

#. Class comment for Dublin Core:ProvenanceStatement
msgid ""
"A statement of any changes in ownership and custody of a resource since its "
"creation that are significant for its authenticity, integrity, and "
"interpretation."
msgstr ""
"Oświadczenie o wszelkich zmianach w posiadaniu i przechowywaniu zasobu od "
"momentu jego utworzenia, które są istotne dla jego autentyczności, "
"integralności i interpretacji."

#. Class label for Dublin Core:RightsStatement
msgid "Rights Statement"
msgstr "Oświadczenie o prawach"

#. Class comment for Dublin Core:RightsStatement
msgid ""
"A statement about the intellectual property rights (IPR) held in or over a "
"Resource, a legal document giving official permission to do something with a"
" resource, or a statement about access rights."
msgstr ""
"Oświadczenie dotyczące praw własności intelektualnej (IPR) posiadanych w lub"
" nad zasobem, dokument prawny udzielający oficjalnego zezwolenia na "
"dokonanie czegoś z zasobem lub oświadczenie dotyczące praw dostępu."

#. Class label for Dublin Core:SizeOrDuration
msgid "Size or Duration"
msgstr "Rozmiar lub Czas trwania"

#. Class comment for Dublin Core:SizeOrDuration
msgid "A dimension or extent, or a time taken to play or execute."
msgstr ""
"Rozmiar zakresu albo czas przeznaczony na odtwarzanie lub wykonywanie."

#. Class label for Dublin Core:Standard
#. Class label for Bibliographic Ontology:Standard
msgid "Standard"
msgstr "Standard"

#. Class comment for Dublin Core:Standard
msgid ""
"A basis for comparison; a reference point against which other things can be "
"evaluated."
msgstr ""
"Podstawa do porównania; punkt odniesienia, względem którego można oceniać "
"inne rzeczy."

#. Property comment for Dublin Core:title
msgid "A name given to the resource."
msgstr "Nazwa nadana zasobowi."

#. Property comment for Dublin Core:creator
msgid "An entity primarily responsible for making the resource."
msgstr "Jednostka odpowiedzialna w pierwszej kolejności za utworzenie zasobu."

#. Property label for Dublin Core:subject
msgid "Subject"
msgstr "Temat"

#. Property comment for Dublin Core:subject
msgid "The topic of the resource."
msgstr "Temat zasobu."

#. Property comment for Dublin Core:description
msgid "An account of the resource."
msgstr "Opis zasobu."

#. Property label for Dublin Core:publisher
msgid "Publisher"
msgstr "Wydawca"

#. Property comment for Dublin Core:publisher
msgid "An entity responsible for making the resource available."
msgstr "Jednostka odpowiedzialna za udostępnienie zasobu."

#. Property label for Dublin Core:contributor
msgid "Contributor"
msgstr "Współtwórca"

#. Property comment for Dublin Core:contributor
msgid "An entity responsible for making contributions to the resource."
msgstr "Jednostka odpowiedzialna za tworzenie wkładu dla zasobu."

#. Property label for Dublin Core:date
msgid "Date"
msgstr "Data"

#. Property comment for Dublin Core:date
msgid ""
"A point or period of time associated with an event in the lifecycle of the "
"resource."
msgstr "Punkt lub okres czasu związany z wydarzeniem w cyklu życia zasobu."

#. Property comment for Dublin Core:type
msgid "The nature or genre of the resource."
msgstr "Charakter lub gatunek zasobu."

#. Property label for Dublin Core:format
msgid "Format"
msgstr "Format"

#. Property comment for Dublin Core:format
msgid "The file format, physical medium, or dimensions of the resource."
msgstr "Format pliku, nośnik fizyczny lub wymiary zasobu."

#. Property label for Dublin Core:identifier
msgid "Identifier"
msgstr "Identyfikator"

#. Property comment for Dublin Core:identifier
msgid "An unambiguous reference to the resource within a given context."
msgstr "Jednoznaczne odniesienie do zasobu w danym kontekście."

#. Property comment for Dublin Core:source
msgid "A related resource from which the described resource is derived."
msgstr "Związany zasób, z którego pochodzi opisany zasób."

#. Property comment for Dublin Core:language
msgid "A language of the resource."
msgstr "Język zasobu."

#. Property label for Dublin Core:relation
msgid "Relation"
msgstr "Relacja"

#. Property comment for Dublin Core:relation
msgid "A related resource."
msgstr "Powiązany zasób."

#. Property label for Dublin Core:coverage
msgid "Coverage"
msgstr "Zakres"

#. Property comment for Dublin Core:coverage
msgid ""
"The spatial or temporal topic of the resource, the spatial applicability of "
"the resource, or the jurisdiction under which the resource is relevant."
msgstr ""
"Temat przestrzenny lub czasowy zasobu, przestrzenna zastosowalność zasobu "
"lub jurysdykcja, w ramach której zasób jest istotny."

#. Property label for Dublin Core:rights
msgid "Rights"
msgstr "Prawa"

#. Property comment for Dublin Core:rights
msgid "Information about rights held in and over the resource."
msgstr ""
"Informacje o prawach posiadanych w odniesieniu do zasobu oraz nad nim."

#. Property label for Dublin Core:audience
msgid "Audience"
msgstr "Odbiorcy"

#. Property comment for Dublin Core:audience
msgid "A class of entity for whom the resource is intended or useful."
msgstr ""
"Klasa jednostek, dla których ten zasób jest przeznaczony lub użyteczny."

#. Property label for Dublin Core:alternative
msgid "Alternative Title"
msgstr "Alternatywny tytuł"

#. Property comment for Dublin Core:alternative
msgid "An alternative name for the resource."
msgstr "Alternatywna nazwa zasobu."

#. Property label for Dublin Core:tableOfContents
msgid "Table Of Contents"
msgstr "Spis treści"

#. Property comment for Dublin Core:tableOfContents
msgid "A list of subunits of the resource."
msgstr "Lista podjednostek zasobu."

#. Property label for Dublin Core:abstract
msgid "Abstract"
msgstr "Abstrakt"

#. Property comment for Dublin Core:abstract
#. Property comment for Bibliographic Ontology:abstract
msgid "A summary of the resource."
msgstr "Podsumowanie zasobu."

#. Property label for Dublin Core:created
msgid "Date Created"
msgstr "Data utworzenia"

#. Property comment for Dublin Core:created
msgid "Date of creation of the resource."
msgstr "Data utworzenia zasobu."

#. Property label for Dublin Core:valid
msgid "Date Valid"
msgstr "Data ważna"

#. Property comment for Dublin Core:valid
msgid "Date (often a range) of validity of a resource."
msgstr "Data (często w zakresie) ważności zasobu."

#. Property label for Dublin Core:available
msgid "Date Available"
msgstr "Data dostępności"

#. Property comment for Dublin Core:available
msgid ""
"Date (often a range) that the resource became or will become available."
msgstr "Data (często zakres) kiedy zasób stał się lub stanie się dostępny."

#. Property label for Dublin Core:issued
msgid "Date Issued"
msgstr "Data wydania"

#. Property comment for Dublin Core:issued
msgid "Date of formal issuance (e.g., publication) of the resource."
msgstr "Data formalnego wydania (np. publikacji) zasobu."

#. Property label for Dublin Core:modified
msgid "Date Modified"
msgstr "Data modyfikacji"

#. Property comment for Dublin Core:modified
msgid "Date on which the resource was changed."
msgstr "Data, w której zasób został zmieniony."

#. Property label for Dublin Core:extent
msgid "Extent"
msgstr "Zakres"

#. Property comment for Dublin Core:extent
msgid "The size or duration of the resource."
msgstr "Rozmiar lub czas trwania zasobu."

#. Property comment for Dublin Core:medium
msgid "The material or physical carrier of the resource."
msgstr "Materiał lub nośnik fizyczny zasobu."

#. Property label for Dublin Core:isVersionOf
msgid "Is Version Of"
msgstr "Jest wersją"

#. Property comment for Dublin Core:isVersionOf
msgid ""
"A related resource of which the described resource is a version, edition, or"
" adaptation."
msgstr ""
"Związany zasób, którego opisywany zasób jest wersją, edycją lub adaptacją."

#. Property label for Dublin Core:hasVersion
msgid "Has Version"
msgstr "Ma wersję"

#. Property comment for Dublin Core:hasVersion
msgid ""
"A related resource that is a version, edition, or adaptation of the "
"described resource."
msgstr ""
"Związany zasób, który jest wersją, edycją lub adaptacją opisanego zasobu."

#. Property label for Dublin Core:isReplacedBy
msgid "Is Replaced By"
msgstr "Zastąpiony przez"

#. Property comment for Dublin Core:isReplacedBy
msgid ""
"A related resource that supplants, displaces, or supersedes the described "
"resource."
msgstr ""
"Związany zasób, który zastępuje, wypiera lub przewyższa opisany zasób."

#. Property label for Dublin Core:replaces
msgid "Replaces"
msgstr "Zastępuje"

#. Property comment for Dublin Core:replaces
msgid ""
"A related resource that is supplanted, displaced, or superseded by the "
"described resource."
msgstr ""
"Związany zasób, który został zastąpiony, wyparty lub wyeliminowany przez "
"opisywany zasób."

#. Property label for Dublin Core:isRequiredBy
msgid "Is Required By"
msgstr "Jest wymagane przez"

#. Property comment for Dublin Core:isRequiredBy
msgid ""
"A related resource that requires the described resource to support its "
"function, delivery, or coherence."
msgstr ""
"Powiązany zasób, który wymaga opisanego zasobu do wsparcia swojej funkcji, "
"dostarczania lub spójności."

#. Property label for Dublin Core:requires
msgid "Requires"
msgstr "Wymaga"

#. Property comment for Dublin Core:requires
msgid ""
"A related resource that is required by the described resource to support its"
" function, delivery, or coherence."
msgstr ""
"Związany zasób, który jest wymagany przez opisywany zasób w celu wsparcia "
"jego funkcji, dostarczania lub spójności."

#. Property label for Dublin Core:isPartOf
msgid "Is Part Of"
msgstr "Jest częścią"

#. Property comment for Dublin Core:isPartOf
msgid ""
"A related resource in which the described resource is physically or "
"logically included."
msgstr ""
"Związany zasób, w którym opisany zasób jest fizycznie lub logicznie zawarty."

#. Property label for Dublin Core:hasPart
msgid "Has Part"
msgstr "Ma część"

#. Property comment for Dublin Core:hasPart
msgid ""
"A related resource that is included either physically or logically in the "
"described resource."
msgstr ""
"Powiązany zasób, który jest zawarty fizycznie lub logicznie w opisywanym "
"zasobie."

#. Property label for Dublin Core:isReferencedBy
msgid "Is Referenced By"
msgstr "Jest cytowany przez"

#. Property comment for Dublin Core:isReferencedBy
msgid ""
"A related resource that references, cites, or otherwise points to the "
"described resource."
msgstr ""
"Związany zasób, który odnosi się do, cytuje lub w inny sposób wskazuje na "
"opisany zasób."

#. Property label for Dublin Core:references
msgid "References"
msgstr "Odnośniki"

#. Property comment for Dublin Core:references
msgid ""
"A related resource that is referenced, cited, or otherwise pointed to by the"
" described resource."
msgstr ""
"Związany zasób, który jest cytowany, odniesiony lub w inny sposób wskazywany"
" przez opisany zasób."

#. Property label for Dublin Core:isFormatOf
msgid "Is Format Of"
msgstr "Czy format jest"

#. Property comment for Dublin Core:isFormatOf
msgid ""
"A related resource that is substantially the same as the described resource,"
" but in another format."
msgstr ""
"Związany zasób, który jest zasadniczo taki sam jak opisany zasób, ale w "
"innym formacie."

#. Property label for Dublin Core:hasFormat
msgid "Has Format"
msgstr "Ma format"

#. Property comment for Dublin Core:hasFormat
msgid ""
"A related resource that is substantially the same as the pre-existing "
"described resource, but in another format."
msgstr ""
"Powiązany zasób, który jest zasadniczo taki sam jak wcześniej opisany zasób,"
" ale w innym formacie."

#. Property label for Dublin Core:conformsTo
msgid "Conforms To"
msgstr "Zgodność z"

#. Property comment for Dublin Core:conformsTo
msgid "An established standard to which the described resource conforms."
msgstr "Ustanowiony standard, do którego opisany zasób się odnosi."

#. Property label for Dublin Core:spatial
msgid "Spatial Coverage"
msgstr "Pokrycie przestrzenne"

#. Property comment for Dublin Core:spatial
msgid "Spatial characteristics of the resource."
msgstr "Cechy przestrzenne zasobu."

#. Property label for Dublin Core:temporal
msgid "Temporal Coverage"
msgstr "Zakres czasowy"

#. Property comment for Dublin Core:temporal
msgid "Temporal characteristics of the resource."
msgstr "Cechy czasowe zasobu."

#. Property label for Dublin Core:mediator
msgid "Mediator"
msgstr "Mediator"

#. Property comment for Dublin Core:mediator
msgid ""
"An entity that mediates access to the resource and for whom the resource is "
"intended or useful."
msgstr ""
"Jednostka pośrednicząca  w dostępie do zasobu i dla której zasób jest "
"przeznaczony bądź użyteczny."

#. Property label for Dublin Core:dateAccepted
msgid "Date Accepted"
msgstr "Data przyjęcia"

#. Property comment for Dublin Core:dateAccepted
msgid "Date of acceptance of the resource."
msgstr "Data akceptacji zasobu."

#. Property label for Dublin Core:dateCopyrighted
msgid "Date Copyrighted"
msgstr "Data objęcia prawami autorskimi"

#. Property comment for Dublin Core:dateCopyrighted
msgid "Date of copyright."
msgstr "Data copyrightu."

#. Property label for Dublin Core:dateSubmitted
msgid "Date Submitted"
msgstr "Data złożenia"

#. Property comment for Dublin Core:dateSubmitted
msgid "Date of submission of the resource."
msgstr "Data złożenia zasobu."

#. Property label for Dublin Core:educationLevel
msgid "Audience Education Level"
msgstr "Poziom wykształcenia odbiorców"

#. Property comment for Dublin Core:educationLevel
msgid ""
"A class of entity, defined in terms of progression through an educational or"
" training context, for which the described resource is intended."
msgstr ""
"Klasa jednostek zdefiniowanych w odniesieniu do postępu poprzez kontekst "
"treningowy lub edukacyjny, dla których opisywany zasób jest przeznaczony."

#. Property label for Dublin Core:accessRights
msgid "Access Rights"
msgstr "Prawo dostępu"

#. Property comment for Dublin Core:accessRights
msgid ""
"Information about who can access the resource or an indication of its "
"security status."
msgstr ""
"Informacje o tym, kto może uzyskać dostęp do zasobu lub wskazanie jego "
"statusu bezpieczeństwa."

#. Property label for Dublin Core:bibliographicCitation
msgid "Bibliographic Citation"
msgstr "Cytacja bibliograficzna"

#. Property comment for Dublin Core:bibliographicCitation
msgid "A bibliographic reference for the resource."
msgstr "Bibliograficzny odnośnik do zasobu."

#. Property label for Dublin Core:license
msgid "License"
msgstr "Licencja"

#. Property comment for Dublin Core:license
msgid ""
"A legal document giving official permission to do something with the "
"resource."
msgstr ""
"Dokument prawny udzielający oficjalnego zezwolenia na dokonanie czegoś z "
"zasobem."

#. Property label for Dublin Core:rightsHolder
msgid "Rights Holder"
msgstr "Posiadacz praw"

#. Property comment for Dublin Core:rightsHolder
msgid "A person or organization owning or managing rights over the resource."
msgstr "Osoba lub organizacja posiadająca lub zarządzająca prawami do zasobu."

#. Property label for Dublin Core:provenance
msgid "Provenance"
msgstr "Pochodzenie"

#. Property comment for Dublin Core:provenance
msgid ""
"A statement of any changes in ownership and custody of the resource since "
"its creation that are significant for its authenticity, integrity, and "
"interpretation."
msgstr ""
"Oświadczenie o wszelkich zmianach w posiadaniu i przechowywaniu zasobu od "
"momentu jego utworzenia, które są istotne dla jego autentyczności, "
"integralności i interpretacji."

#. Property label for Dublin Core:instructionalMethod
msgid "Instructional Method"
msgstr "Metoda instruktażowa"

#. Property comment for Dublin Core:instructionalMethod
msgid ""
"A process, used to engender knowledge, attitudes and skills, that the "
"described resource is designed to support."
msgstr ""
"Proces, który ma na celu rozwijanie wiedzy, postaw i umiejętności, które "
"opisywany zasób ma na celu wspierać."

#. Property label for Dublin Core:accrualMethod
msgid "Accrual Method"
msgstr "Metoda memoriałowa"

#. Property comment for Dublin Core:accrualMethod
msgid "The method by which items are added to a collection."
msgstr "Metoda, za pomocą której pozycje są dodawane do kolekcji."

#. Property label for Dublin Core:accrualPeriodicity
msgid "Accrual Periodicity"
msgstr "Okres narastania"

#. Property comment for Dublin Core:accrualPeriodicity
msgid "The frequency with which items are added to a collection."
msgstr "Częstotliwość, z jaką pozycje są dodawane do kolekcji."

#. Property label for Dublin Core:accrualPolicy
msgid "Accrual Policy"
msgstr "Polityka naliczania"

#. Property comment for Dublin Core:accrualPolicy
msgid "The policy governing the addition of items to a collection."
msgstr "Polityka regulująca dodawanie pozycji do kolekcji."

#. Vocabulary label for Dublin Core Type
msgid "Dublin Core Type"
msgstr "Typ Dublin Core"

#. Vocabulary comment for Dublin Core Type
msgid "Basic resource types (DCMI Type Vocabulary)"
msgstr "Podstawowe typy zasobów (Słownik typów DCMI)"

#. Class label for Dublin Core Type:Collection
#. Class label for Bibliographic Ontology:Collection
msgid "Collection"
msgstr "Kolekcja"

#. Class comment for Dublin Core Type:Collection
msgid "An aggregation of resources."
msgstr "Agregacja zasobów."

#. Class label for Dublin Core Type:Dataset
msgid "Dataset"
msgstr "Zbiór danych"

#. Class comment for Dublin Core Type:Dataset
msgid "Data encoded in a defined structure."
msgstr "Dane zakodowane w zdefiniowanej strukturze."

#. Class label for Dublin Core Type:Event
#. Class label for Bibliographic Ontology:Event
msgid "Event"
msgstr "Wydarzenie"

#. Class comment for Dublin Core Type:Event
msgid "A non-persistent, time-based occurrence."
msgstr "Niepr persistentne, oparte na czasie zdarzenie."

#. Class comment for Dublin Core Type:Image
msgid "A visual representation other than text."
msgstr "Wizualna reprezentacja inna niż tekst."

#. Class label for Dublin Core Type:InteractiveResource
msgid "Interactive Resource"
msgstr "Zasób interaktywny"

#. Class comment for Dublin Core Type:InteractiveResource
msgid ""
"A resource requiring interaction from the user to be understood, executed, "
"or experienced."
msgstr ""
"Zasób wymagający interakcji od użytkownika, aby mógł być zrozumiany, "
"wykonany lub doświadczony."

#. Class label for Dublin Core Type:Service
msgid "Service"
msgstr "Usługa"

#. Class comment for Dublin Core Type:Service
msgid "A system that provides one or more functions."
msgstr "System, który zapewnia jedną lub więcej funkcji."

#. Class label for Dublin Core Type:Software
msgid "Software"
msgstr "Oprogramowanie"

#. Class comment for Dublin Core Type:Software
msgid "A computer program in source or compiled form."
msgstr "Program komputerowy w postaci źródłowej lub skompilowanej."

#. Class label for Dublin Core Type:Sound
msgid "Sound"
msgstr "Dźwięk"

#. Class comment for Dublin Core Type:Sound
msgid "A resource primarily intended to be heard."
msgstr "Zasób przeznaczony głównie do słuchania."

#. Class comment for Dublin Core Type:Text
msgid "A resource consisting primarily of words for reading."
msgstr "Zasób składający się głównie z tekstu do czytania."

#. Class label for Dublin Core Type:PhysicalObject
msgid "Physical Object"
msgstr "Obiekt fizyczny"

#. Class comment for Dublin Core Type:PhysicalObject
msgid "An inanimate, three-dimensional object or substance."
msgstr "Nieożywiony, trójwymiarowy obiekt lub substancja."

#. Class label for Dublin Core Type:StillImage
msgid "Still Image"
msgstr "Obraz statyczny"

#. Class comment for Dublin Core Type:StillImage
msgid "A static visual representation."
msgstr "Statyczna wizualna reprezentacja."

#. Class label for Dublin Core Type:MovingImage
msgid "Moving Image"
msgstr "Obraz ruchomy"

#. Class comment for Dublin Core Type:MovingImage
msgid ""
"A series of visual representations imparting an impression of motion when "
"shown in succession."
msgstr ""
"Seria wizualnych przedstawień, które wywołują wrażenie ruchu, gdy są "
"pokazywane w kolejności."

#. Vocabulary label for Bibliographic Ontology
msgid "Bibliographic Ontology"
msgstr "Ontologia bibliograficzna"

#. Vocabulary comment for Bibliographic Ontology
msgid "Bibliographic metadata (BIBO)"
msgstr "Metadane bibliograficzne (BIBO)"

#. Class label for Bibliographic Ontology:AcademicArticle
msgid "Academic Article"
msgstr "Artykuł naukowy"

#. Class comment for Bibliographic Ontology:AcademicArticle
msgid "A scholarly academic article, typically published in a journal."
msgstr "Artykuł naukowy, zazwyczaj publikowany w czasopiśmie."

#. Class label for Bibliographic Ontology:Article
msgid "Article"
msgstr "Artykuł"

#. Class comment for Bibliographic Ontology:Article
msgid ""
"A written composition in prose, usually nonfiction, on a specific topic, "
"forming an independent part of a book or other publication, as a newspaper "
"or magazine."
msgstr ""
"Pisemna kompozycja w prozie, zazwyczaj nienarracyjna, na określony temat, "
"stanowiąca niezależną część książki lub innej publikacji, takiej jak gazeta "
"czy czasopismo."

#. Class label for Bibliographic Ontology:AudioDocument
msgid "audio document"
msgstr "dokument audio"

#. Class comment for Bibliographic Ontology:AudioDocument
msgid "An audio document; aka record."
msgstr "Dokument audio; znany również jako nagranie."

#. Class label for Bibliographic Ontology:AudioVisualDocument
msgid "audio-visual document"
msgstr "dokument audiowizualny"

#. Class comment for Bibliographic Ontology:AudioVisualDocument
msgid "An audio-visual document; film, video, and so forth."
msgstr "Dokument audiowizualny; film, wideo itp."

#. Class label for Bibliographic Ontology:Bill
msgid "Bill"
msgstr "Rachunek"

#. Class comment for Bibliographic Ontology:Bill
msgid "Draft legislation presented for discussion to a legal body."
msgstr "Projekt ustawy przedstawiony do dyskusji organowi prawnemu."

#. Class label for Bibliographic Ontology:Book
msgid "Book"
msgstr "Książka"

#. Class comment for Bibliographic Ontology:Book
msgid ""
"A written or printed work of fiction or nonfiction, usually on sheets of "
"paper fastened or bound together within covers."
msgstr ""
"Pisana lub drukowana praca fikcyjna lub niefikcyjna, zwykle na arkuszach "
"papieru zszytych lub oprawionych w okładki."

#. Class label for Bibliographic Ontology:BookSection
msgid "Book Section"
msgstr "Sekcja książki"

#. Class comment for Bibliographic Ontology:BookSection
msgid "A section of a book."
msgstr "Sekcja książki."

#. Class label for Bibliographic Ontology:Brief
msgid "Brief"
msgstr "Streszczenie"

#. Class comment for Bibliographic Ontology:Brief
msgid "A written argument submitted to a court."
msgstr "Pisemny argument złożony do sądu."

#. Class label for Bibliographic Ontology:Chapter
msgid "Chapter"
msgstr "Rozdział"

#. Class comment for Bibliographic Ontology:Chapter
msgid "A chapter of a book."
msgstr "Rozdział książki."

#. Class label for Bibliographic Ontology:Code
msgid "Code"
msgstr "Kod"

#. Class comment for Bibliographic Ontology:Code
msgid "A collection of statutes."
msgstr "Zbiór ustaw."

#. Class label for Bibliographic Ontology:CollectedDocument
msgid "Collected Document"
msgstr "Zebrany dokument"

#. Class comment for Bibliographic Ontology:CollectedDocument
msgid "A document that simultaneously contains other documents."
msgstr "Dokument, który jednocześnie zawiera inne dokumenty."

#. Class comment for Bibliographic Ontology:Collection
msgid "A collection of Documents or Collections"
msgstr "Zbiór dokumentów lub kolekcji"

#. Class label for Bibliographic Ontology:Conference
msgid "Conference"
msgstr "Konferencja"

#. Class comment for Bibliographic Ontology:Conference
msgid "A meeting for consultation or discussion."
msgstr "Spotkanie w celu konsultacji lub dyskusji."

#. Class label for Bibliographic Ontology:CourtReporter
msgid "Court Reporter"
msgstr "Reporter sądowy"

#. Class comment for Bibliographic Ontology:CourtReporter
msgid "A collection of legal cases."
msgstr "Zbiór spraw prawnych."

#. Class label for Bibliographic Ontology:Document
#. Class label for Friend of a Friend:Document
msgid "Document"
msgstr "Dokument"

#. Class comment for Bibliographic Ontology:Document
msgid ""
"A document (noun) is a bounded physical representation of body of "
"information designed with the capacity (and usually intent) to communicate. "
"A document may manifest symbolic, diagrammatic or sensory-representational "
"information."
msgstr ""
"Dokument (rzeczownik) to ograniczona fizyczna reprezentacja zbioru "
"informacji zaprojektowana z zdolnością (a zazwyczaj także intencją) do "
"komunikacji. Dokument może manifestować informacje symboliczne, "
"diagramatyczne lub sensoryczno-reprezentacyjne."

#. Class label for Bibliographic Ontology:DocumentPart
msgid "document part"
msgstr "część dokumentu"

#. Class comment for Bibliographic Ontology:DocumentPart
msgid "a distinct part of a larger document or collected document."
msgstr "wyraźna część większego dokumentu lub zbioru dokumentów."

#. Class label for Bibliographic Ontology:DocumentStatus
msgid "Document Status"
msgstr "Status dokumentu"

#. Class comment for Bibliographic Ontology:DocumentStatus
msgid "The status of the publication of a document."
msgstr "Status publikacji dokumentu."

#. Class label for Bibliographic Ontology:EditedBook
msgid "Edited Book"
msgstr "Edytowana książka"

#. Class comment for Bibliographic Ontology:EditedBook
msgid "An edited book."
msgstr "Książka redagowana."

#. Class label for Bibliographic Ontology:Email
msgid "EMail"
msgstr "Email"

#. Class comment for Bibliographic Ontology:Email
msgid ""
"A written communication addressed to a person or organization and "
"transmitted electronically."
msgstr ""
"Pisemna komunikacja skierowana do osoby lub organizacji i przesyłana "
"elektronicznie."

#. Class label for Bibliographic Ontology:Excerpt
msgid "Excerpt"
msgstr "Fragment"

#. Class comment for Bibliographic Ontology:Excerpt
msgid "A passage selected from a larger work."
msgstr "Fragment wybrany z większego dzieła."

#. Class label for Bibliographic Ontology:Film
msgid "Film"
msgstr "Film"

#. Class comment for Bibliographic Ontology:Film
msgid "aka movie."
msgstr "jaki film."

#. Class label for Bibliographic Ontology:Hearing
msgid "Hearing"
msgstr "Rozprawa"

#. Class comment for Bibliographic Ontology:Hearing
msgid ""
"An instance or a session in which testimony and arguments are presented, "
"esp. before an official, as a judge in a lawsuit."
msgstr ""
"Instancja lub sesja, w której przedstawiane są zeznania i argumenty, "
"szczególnie przed urzędnikiem, takim jak sędzia w sprawie sądowej."

#. Class comment for Bibliographic Ontology:Image
msgid "A document that presents visual or diagrammatic information."
msgstr "Dokument przedstawiający informacje wizualne lub diagramowe."

#. Class label for Bibliographic Ontology:Interview
msgid "Interview"
msgstr "Wywiad"

#. Class comment for Bibliographic Ontology:Interview
msgid "A formalized discussion between two or more people."
msgstr "Sformalizowana dyskusja między dwiema lub więcej osobami."

#. Class label for Bibliographic Ontology:Issue
msgid "Issue"
msgstr "Problem"

#. Class comment for Bibliographic Ontology:Issue
msgid ""
"something that is printed or published and distributed, esp. a given number "
"of a periodical"
msgstr ""
"coś, co jest drukowane lub publikowane i dystrybuowane, zwłaszcza dany numer"
" periodyku"

#. Class label for Bibliographic Ontology:Journal
msgid "Journal"
msgstr "Czasopismo"

#. Class comment for Bibliographic Ontology:Journal
msgid "A periodical of scholarly journal Articles."
msgstr "Wydanie czasopisma naukowego."

#. Class label for Bibliographic Ontology:LegalCaseDocument
msgid "Legal Case Document"
msgstr "Dokument sprawy prawnej"

#. Class comment for Bibliographic Ontology:LegalCaseDocument
msgid "A document accompanying a legal case."
msgstr "Dokument towarzyszący sprawie prawnej."

#. Class label for Bibliographic Ontology:LegalDecision
msgid "Decision"
msgstr "Decyzja"

#. Class comment for Bibliographic Ontology:LegalDecision
msgid ""
"A document containing an authoritative determination (as a decree or "
"judgment) made after consideration of facts or law."
msgstr ""
"Dokument zawierający autorytatywne orzeczenie (np. dekret lub wyrok) podjęte"
" po rozważeniu faktów lub prawa."

#. Class label for Bibliographic Ontology:LegalDocument
msgid "Legal Document"
msgstr "Dokument prawny"

#. Class comment for Bibliographic Ontology:LegalDocument
msgid ""
"A legal document; for example, a court decision, a brief, and so forth."
msgstr "Dokument prawny; na przykład, orzeczenie sądu, notatka, itp."

#. Class label for Bibliographic Ontology:Legislation
msgid "Legislation"
msgstr "Ustawodawstwo"

#. Class comment for Bibliographic Ontology:Legislation
msgid "A legal document proposing or enacting a law or a group of laws."
msgstr "Dokument prawny proponujący lub wprowadzający prawo lub grupę praw."

#. Class label for Bibliographic Ontology:Letter
msgid "Letter"
msgstr "List"

#. Class comment for Bibliographic Ontology:Letter
msgid ""
"A written or printed communication addressed to a person or organization and"
" usually transmitted by mail."
msgstr ""
"Pisemna lub drukowana komunikacja skierowana do osoby lub organizacji, "
"zwykle przesyłana pocztą."

#. Class label for Bibliographic Ontology:Magazine
msgid "Magazine"
msgstr "Czasopismo"

#. Class comment for Bibliographic Ontology:Magazine
msgid ""
"A periodical of magazine Articles. A magazine is a publication that is "
"issued periodically, usually bound in a paper cover, and typically contains "
"essays, stories, poems, etc., by many writers, and often photographs and "
"drawings, frequently specializing in a particular subject or area, as "
"hobbies, news, or sports."
msgstr ""
"Wydanie periodyczne artykułów magazynowych. Magazyn to publikacja, która "
"ukazuje się okresowo, zwykle oprawiona w papierową okładkę i zazwyczaj "
"zawiera eseje, opowiadania, wiersze itp. autorstwa wielu pisarzy, a także "
"często fotografie i rysunki, często specjalizująca się w określonym temacie "
"lub dziedzinie, takiej jak hobby, wiadomości czy sport."

#. Class label for Bibliographic Ontology:Manual
msgid "Manual"
msgstr "Podręcznik"

#. Class comment for Bibliographic Ontology:Manual
msgid "A small reference book, especially one giving instructions."
msgstr ""
"Mała książka referencyjna, szczególnie taka, która zawiera instrukcje."

#. Class label for Bibliographic Ontology:Manuscript
msgid "Manuscript"
msgstr "Rękopis"

#. Class comment for Bibliographic Ontology:Manuscript
msgid ""
"An unpublished Document, which may also be submitted to a publisher for "
"publication."
msgstr ""
"Nieopublikowany dokument, który może być również przesłany do wydawcy w celu"
" publikacji."

#. Class label for Bibliographic Ontology:Map
msgid "Map"
msgstr "Mapa"

#. Class comment for Bibliographic Ontology:Map
msgid "A graphical depiction of geographic features."
msgstr "Graficzne przedstawienie cech geograficznych."

#. Class label for Bibliographic Ontology:MultiVolumeBook
msgid "Multivolume Book"
msgstr "Książka wielotomowa"

#. Class comment for Bibliographic Ontology:MultiVolumeBook
#. Class comment for Bibliographic Ontology:Series
msgid "A loose, thematic, collection of Documents, often Books."
msgstr "Luźna, tematyczna kolekcja dokumentów, często książek."

#. Class label for Bibliographic Ontology:Newspaper
msgid "Newspaper"
msgstr "Gazeta"

#. Class comment for Bibliographic Ontology:Newspaper
msgid ""
"A periodical of documents, usually issued daily or weekly, containing "
"current news, editorials, feature articles, and usually advertising."
msgstr ""
"Wydania dokumentów ukazujących się zwykle codziennie lub cotygodniowo, "
"zawierających aktualne informacje, artykuły wstępne, polecane artykuły oraz "
"zwykle ogłoszenia."

#. Class label for Bibliographic Ontology:Note
msgid "Note"
msgstr "Uwaga"

#. Class comment for Bibliographic Ontology:Note
msgid "Notes or annotations about a resource."
msgstr "Notatki lub adnotacje dotyczące zasobu."

#. Class label for Bibliographic Ontology:Patent
msgid "Patent"
msgstr "Patent"

#. Class comment for Bibliographic Ontology:Patent
msgid ""
"A document describing the exclusive right granted by a government to an "
"inventor to manufacture, use, or sell an invention for a certain number of "
"years."
msgstr ""
"Dokument opisujący wyłączne prawo przyznane przez rząd wynalazcy do "
"wytwarzania, używania lub sprzedaży wynalazku przez określoną liczbę lat."

#. Class label for Bibliographic Ontology:Performance
msgid "Performance"
msgstr "Wydajność"

#. Class comment for Bibliographic Ontology:Performance
msgid "A public performance."
msgstr "Publiczny występ."

#. Class label for Bibliographic Ontology:Periodical
msgid "Periodical"
msgstr "Czasopismo"

#. Class comment for Bibliographic Ontology:Periodical
msgid "A group of related documents issued at regular intervals."
msgstr "Grupa powiązanych dokumentów wydawanych w regularnych odstępach."

#. Class label for Bibliographic Ontology:PersonalCommunication
msgid "Personal Communication"
msgstr "Komunikacja osobista"

#. Class comment for Bibliographic Ontology:PersonalCommunication
msgid "A communication between an agent and one or more specific recipients."
msgstr ""
"Komunikacja między agentem a jednym lub więcej konkretnymi odbiorcami."

#. Class label for Bibliographic Ontology:PersonalCommunicationDocument
msgid "Personal Communication Document"
msgstr "Dokument komunikacji osobistej"

#. Class comment for Bibliographic Ontology:PersonalCommunicationDocument
msgid "A personal communication manifested in some document."
msgstr "Osobista komunikacja przejawiająca się w jakimś dokumencie."

#. Class label for Bibliographic Ontology:Proceedings
msgid "Proceedings"
msgstr "Materiały konferencyjne"

#. Class comment for Bibliographic Ontology:Proceedings
msgid ""
"A compilation of documents published from an event, such as a conference."
msgstr ""
"Kompilacja dokumentów opublikowanych z wydarzenia, takiego jak konferencja."

#. Class label for Bibliographic Ontology:Quote
msgid "Quote"
msgstr "Cytat"

#. Class comment for Bibliographic Ontology:Quote
msgid "An excerpted collection of words."
msgstr "Wyciągnięta kolekcja słów."

#. Class label for Bibliographic Ontology:ReferenceSource
msgid "Reference Source"
msgstr "Źródło odniesienia"

#. Class comment for Bibliographic Ontology:ReferenceSource
msgid ""
"A document that presents authoritative reference information, such as a "
"dictionary or encylopedia ."
msgstr ""
"Dokument przedstawiający autorytatywne informacje referencyjne, takie jak "
"słownik lub encyklopedia."

#. Class label for Bibliographic Ontology:Report
msgid "Report"
msgstr "Raport"

#. Class comment for Bibliographic Ontology:Report
msgid ""
"A document describing an account or statement describing in detail an event,"
" situation, or the like, usually as the result of observation, inquiry, "
"etc.."
msgstr ""
"Dokument opisujący relację lub oświadczenie szczegółowo opisujące zdarzenie,"
" sytuację lub podobne, zazwyczaj jako wynik obserwacji, dochodzenia itp."

#. Class label for Bibliographic Ontology:Series
msgid "Series"
msgstr "Seria"

#. Class label for Bibliographic Ontology:Slide
msgid "Slide"
msgstr "Slajd"

#. Class comment for Bibliographic Ontology:Slide
msgid "A slide in a slideshow"
msgstr "Slajd w pokazie slajdów"

#. Class label for Bibliographic Ontology:Slideshow
msgid "Slideshow"
msgstr "Pokaz slajdów"

#. Class comment for Bibliographic Ontology:Slideshow
msgid ""
"A presentation of a series of slides, usually presented in front of an "
"audience with written text and images."
msgstr ""
"Prezentacja serii slajdów, zazwyczaj przedstawiana przed publicznością z "
"pisemnym tekstem i obrazami."

#. Class comment for Bibliographic Ontology:Standard
msgid "A document describing a standard"
msgstr "Dokument opisujący standard"

#. Class label for Bibliographic Ontology:Statute
msgid "Statute"
msgstr "Ustawa"

#. Class comment for Bibliographic Ontology:Statute
msgid "A bill enacted into law."
msgstr "Ustawa uchwalona w życie."

#. Class label for Bibliographic Ontology:Thesis
msgid "Thesis"
msgstr "Praca dyplomowa"

#. Class comment for Bibliographic Ontology:Thesis
msgid ""
"A document created to summarize research findings associated with the "
"completion of an academic degree."
msgstr ""
"Dokument stworzony w celu podsumowania wyników badań związanych z "
"ukończeniem stopnia akademickiego."

#. Class label for Bibliographic Ontology:ThesisDegree
msgid "Thesis degree"
msgstr "Stopień naukowy"

#. Class comment for Bibliographic Ontology:ThesisDegree
msgid "The academic degree of a Thesis"
msgstr "Stopień naukowy pracy dyplomowej"

#. Class label for Bibliographic Ontology:Webpage
msgid "Webpage"
msgstr "Strona internetowa"

#. Class comment for Bibliographic Ontology:Webpage
msgid ""
"A web page is an online document available (at least initially) on the world"
" wide web. A web page is written first and foremost to appear on the web, as"
" distinct from other online resources such as books, manuscripts or audio "
"documents which use the web primarily as a distribution mechanism alongside "
"other more traditional methods such as print."
msgstr ""
"Strona internetowa to dokument online dostępny (przynajmniej początkowo) w "
"sieci World Wide Web. Strona internetowa jest pisana przede wszystkim po to,"
" aby pojawić się w sieci, w odróżnieniu od innych zasobów online, takich jak"
" książki, rękopisy czy dokumenty audio, które wykorzystują sieć głównie jako"
" mechanizm dystrybucji obok innych, bardziej tradycyjnych metod, takich jak "
"druk."

#. Class label for Bibliographic Ontology:Website
msgid "Website"
msgstr "Strona internetowa"

#. Class comment for Bibliographic Ontology:Website
msgid "A group of Webpages accessible on the Web."
msgstr "Grupa stron internetowych dostępnych w sieci."

#. Class label for Bibliographic Ontology:Workshop
msgid "Workshop"
msgstr "Warsztat"

#. Class comment for Bibliographic Ontology:Workshop
msgid ""
"A seminar, discussion group, or the like, that emphasizes zxchange of ideas "
"and the demonstration and application of techniques, skills, etc."
msgstr ""
"Seminarium, grupa dyskusyjna lub podobne, które kładzie nacisk na wymianę "
"pomysłów oraz demonstrowanie i zastosowanie technik, umiejętności itp."

#. Property label for Bibliographic Ontology:affirmedBy
msgid "affirmedBy"
msgstr "potwierdzone przez"

#. Property comment for Bibliographic Ontology:affirmedBy
msgid "A legal decision that affirms a ruling."
msgstr "Decyzja prawna, która potwierdza orzeczenie."

#. Property label for Bibliographic Ontology:annotates
msgid "annotates"
msgstr "adnotuje"

#. Property comment for Bibliographic Ontology:annotates
msgid "Critical or explanatory note for a Document."
msgstr "Krytyczna lub wyjaśniająca uwaga dotycząca dokumentu."

#. Property label for Bibliographic Ontology:authorList
msgid "list of authors"
msgstr "lista autorów"

#. Property comment for Bibliographic Ontology:authorList
msgid ""
"An ordered list of authors. Normally, this list is seen as a priority list "
"that order authors by importance."
msgstr ""
"Uporządkowana lista autorów. Zwykle ta lista jest postrzegana jako lista "
"priorytetów, porządkująca autorów według ważności."

#. Property label for Bibliographic Ontology:citedBy
msgid "cited by"
msgstr "cytowany przez"

#. Property comment for Bibliographic Ontology:citedBy
msgid ""
"Relates a document to another document that cites the\n"
"first document."
msgstr "Odnosi dany dokument do innego dokumentu, który cytuje ten pierwszy."

#. Property label for Bibliographic Ontology:cites
msgid "cites"
msgstr "cytaty"

#. Property comment for Bibliographic Ontology:cites
msgid ""
"Relates a document to another document that is cited\n"
"by the first document as reference, comment, review, quotation or for\n"
"another purpose."
msgstr ""
"Odnosi dany dokument do innego, który jest cytowany przez ten pierwszy jako "
"odniesienie, komentarz, przegląd, wycena lub w innym celu."

#. Property label for Bibliographic Ontology:contributorList
msgid "list of contributors"
msgstr "lista współtwórców"

#. Property comment for Bibliographic Ontology:contributorList
msgid ""
"An ordered list of contributors. Normally, this list is seen as a priority "
"list that order contributors by importance."
msgstr ""
"Uporządkowana lista współtwórców. Zwykle ta lista jest postrzegana jako "
"lista priorytetów, porządkująca współtwórców według ważności."

#. Property label for Bibliographic Ontology:court
msgid "court"
msgstr "sąd"

#. Property comment for Bibliographic Ontology:court
msgid ""
"A court associated with a legal document; for example, that which issues a "
"decision."
msgstr ""
"Sąd związany z dokumentem prawnym; na przykład, ten, który wydaje decyzję."

#. Property label for Bibliographic Ontology:degree
msgid "degree"
msgstr "stopień"

#. Property comment for Bibliographic Ontology:degree
msgid "The thesis degree."
msgstr "Stopień naukowy."

#. Property label for Bibliographic Ontology:director
msgid "director"
msgstr "dyrektor"

#. Property comment for Bibliographic Ontology:director
msgid "A Film director."
msgstr "Reżyser filmowy."

#. Property label for Bibliographic Ontology:distributor
msgid "distributor"
msgstr "dystrybutor"

#. Property comment for Bibliographic Ontology:distributor
msgid "Distributor of a document or a collection of documents."
msgstr "Dystrybutor dokumentu lub zbioru dokumentów."

#. Property label for Bibliographic Ontology:editor
msgid "editor"
msgstr "edytor"

#. Property comment for Bibliographic Ontology:editor
msgid ""
"A person having managerial and sometimes policy-making responsibility for "
"the editorial part of a publishing firm or of a newspaper, magazine, or "
"other publication."
msgstr ""
"Osoba posiadająca odpowiedzialność menedżerską, a czasami także decyzyjną, "
"za część edytorską firmy wydawniczej lub gazety, czasopisma czy innej "
"publikacji."

#. Property label for Bibliographic Ontology:editorList
msgid "list of editors"
msgstr "lista edytorów"

#. Property comment for Bibliographic Ontology:editorList
msgid ""
"An ordered list of editors. Normally, this list is seen as a priority list "
"that order editors by importance."
msgstr ""
"Uporządkowana lista edytorów. Zwykle ta lista jest postrzegana jako lista "
"priorytetów, porządkująca edytorów według ważności."

#. Property label for Bibliographic Ontology:interviewee
msgid "interviewee"
msgstr "osoba przesłuchiwana"

#. Property comment for Bibliographic Ontology:interviewee
msgid "An agent that is interviewed by another agent."
msgstr "Agent, który jest przesłuchiwany przez innego agenta."

#. Property label for Bibliographic Ontology:interviewer
msgid "interviewer"
msgstr "interviewer"

#. Property comment for Bibliographic Ontology:interviewer
msgid "An agent that interview another agent."
msgstr "Agent, który przeprowadza wywiad z innym agentem."

#. Property label for Bibliographic Ontology:issuer
msgid "issuer"
msgstr "wydawca"

#. Property comment for Bibliographic Ontology:issuer
msgid ""
"An entity responsible for issuing often informally published documents such "
"as press releases, reports, etc."
msgstr ""
"Jednostka odpowiedzialna za wydawanie często nieformalnie publikowanych "
"dokumentów takich jak informacje prasowe, raporty, itp."

#. Property label for Bibliographic Ontology:organizer
msgid "organizer"
msgstr "organizator"

#. Property comment for Bibliographic Ontology:organizer
msgid ""
"The organizer of an event; includes conference organizers, but also "
"government agencies or other bodies that are responsible for conducting "
"hearings."
msgstr ""
"Organizator wydarzenia; obejmuje organizatorów konferencji, ale także "
"agencje rządowe lub inne podmioty odpowiedzialne za przeprowadzanie "
"przesłuchań."

#. Property label for Bibliographic Ontology:owner
msgid "owner"
msgstr "właściciel"

#. Property comment for Bibliographic Ontology:owner
msgid "Owner of a document or a collection of documents."
msgstr "Właściciel dokumentu lub zbioru dokumentów."

#. Property label for Bibliographic Ontology:performer
