# A vocabulary that first declares the namespace of one it reuses, and
# redeclares one of its terms, before its own, which has more.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix own: <http://example.org/own#> .

<http://purl.org/dc/terms/> vann:preferredNamespaceUri "http://purl.org/dc/terms/" .
dcterms:title a rdf:Property .

<http://example.org/own> a owl:Ontology ;
    vann:preferredNamespaceUri "http://example.org/own#" .
own:Thing a rdfs:Class .
own:name a rdf:Property .
own:part a rdf:Property .
