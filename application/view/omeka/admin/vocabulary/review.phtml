<?php
$this->headScript()->appendFile($this->assetUrl('js/vocabulary-form.js', 'Omeka'));
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$this->htmlElement('body')->appendAttribute('class', 'vocabularies review');
$prefix = $vocabulary->prefix();
$sourceLabel = $review['source_label'] ?? $translate('the file');

$lang = (string) ($importOptions['lang'] ?? '');
$commentProperty = $importOptions['comment_property'] ?? \Omeka\Stdlib\RdfImporter::COMMENT_PROPERTY;
$comments = array_search($commentProperty, \Omeka\Stdlib\RdfImporter::COMMENT_PROPERTY_CHOICES, true);
// A comment property the Comments field doesn't offer, or a label property
// other than the default, was entered by hand, so its box is filled in.
$otherCommentProperty = false === $comments ? $commentProperty : '';
$comments = $comments ?: 'other';
$labelProperty = $importOptions['label_property'] ?? \Omeka\Stdlib\RdfImporter::LABEL_PROPERTY;
$otherLabelProperty = \Omeka\Stdlib\RdfImporter::LABEL_PROPERTY === $labelProperty ? '' : $labelProperty;

// Omeka's labels, which name the terms.
$labels = ['classes' => [], 'properties' => []];
foreach ($vocabulary->resourceClasses() as $class) {
    $labels['classes'][$class->localName()] = $class->label();
}
foreach ($vocabulary->properties() as $property) {
    $labels['properties'][$property->localName()] = $property->label();
}
$term = function ($localName, $label = null) use ($prefix, $escape) {
    $term = sprintf('<span class="field-term">%s</span>', $escape($prefix . ':' . $localName));
    return null === $label || '' === $label ? $term : sprintf('<span class="review-term-label">%s</span> %s', $escape($label), $term);
};

$none = sprintf('<span class="review-none">%s</span>', $translate('None'));
$value = function ($value) use ($none, $escape) {
    if (null === $value || '' === $value) {
        return $none;
    }
    return sprintf('<span class="review-value">%s</span>', $escape($value));
};
// A changed value, with what differs from the other value marked.
$textDiff = $this->plugin('textDiff');
$fromTo = function ($from, $to) use ($value, $textDiff) {
    [$from, $to] = [(string) $from, (string) $to];
    if ('' === $from || '' === $to) {
        return [$value($from), $value($to)];
    }
    return array_map(function ($html) {
        return sprintf('<span class="review-value">%s</span>', $html);
    }, $textDiff($from, $to));
};
$byTerm = function ($a, $b) {
    return strnatcasecmp((string) $a, (string) $b);
};
$changed = function (array $changes, array $termLabels) use ($term, $fromTo, $byTerm) {
    uksort($changes, $byTerm);
    $rows = [];
    foreach ($changes as $localName => [$from, $to]) {
        $rows[] = array_merge([$term($localName, $termLabels[$localName] ?? null)], $fromTo($from, $to));
    }
    return $rows;
};
$listed = function (array $terms) use ($term, $value, $byTerm) {
    uksort($terms, $byTerm);
    $rows = [];
    foreach ($terms as $localName => $values) {
        $rows[] = array_merge([$term($localName)], array_map($value, (array) $values));
    }
    return $rows;
};

// Whether the review also changes the namespace URI, shown whole rather
// than marked word by word.
$namespaceChanges = null !== $review['new_namespace_uri'];

// Labels first, which everyone sees, then new terms, comments, and the terms
// only in Omeka, which aren't changes.
$sections = [];
if (null !== $diff) {
    $kinds = ['properties' => $translate('Property'), 'classes' => $translate('Class')];
    $sections = [
        ['id' => 'review-property-labels', 'heading' => $translate('Changed property labels'), 'columns' => [$kinds['properties'], $translate('From'), $translate('To')], 'rows' => $changed($diff['properties']['label'], $labels['properties']), 'class' => 'review-changes'],
        ['id' => 'review-class-labels', 'heading' => $translate('Changed class labels'), 'columns' => [$kinds['classes'], $translate('From'), $translate('To')], 'rows' => $changed($diff['classes']['label'], $labels['classes']), 'class' => 'review-changes'],
        ['id' => 'review-new-properties', 'heading' => $translate('New properties'), 'columns' => [$kinds['properties'], $translate('Label'), $translate('Comment')], 'rows' => $listed($diff['properties']['new'])],
        ['id' => 'review-new-classes', 'heading' => $translate('New classes'), 'columns' => [$kinds['classes'], $translate('Label'), $translate('Comment')], 'rows' => $listed($diff['classes']['new'])],
        ['id' => 'review-property-comments', 'heading' => $translate('Changed property comments'), 'columns' => [$kinds['properties'], $translate('From'), $translate('To')], 'rows' => $changed($diff['properties']['comment'], $labels['properties']), 'class' => 'review-changes'],
        ['id' => 'review-class-comments', 'heading' => $translate('Changed class comments'), 'columns' => [$kinds['classes'], $translate('From'), $translate('To')], 'rows' => $changed($diff['classes']['comment'], $labels['classes']), 'class' => 'review-changes'],
    ];
    $onlyInOmeka = sprintf($translate('This vocabulary has these, and %s doesn\'t. Accepting keeps them.'), $escape($sourceLabel));
    $sections[] = ['id' => 'review-properties-only-in-omeka', 'heading' => $translate('Properties only in Omeka'), 'columns' => [$kinds['properties'], $translate('Label')], 'rows' => $listed($missing['properties']), 'note' => $onlyInOmeka];
    $sections[] = ['id' => 'review-classes-only-in-omeka', 'heading' => $translate('Classes only in Omeka'), 'columns' => [$kinds['classes'], $translate('Label')], 'rows' => $listed($missing['classes']), 'note' => $onlyInOmeka];
}
$termChanges = 0;
foreach ($sections as $section) {
    $termChanges += isset($section['note']) ? 0 : count($section['rows']);
}
$sections = array_filter($sections, function ($section) {
    return (bool) $section['rows'];
});
$changes = null !== $diff && ($termChanges || $namespaceChanges);
?>

<?php echo $this->pageTitle($vocabulary->label(), 1, $translate('Vocabularies'), $translate('Review changes')); ?>

<?php // Only the actions and hidden inputs, so the form of choices doesn't nest in it. ?>
<form method="post" action="<?php echo $escape($this->url(null, ['action' => 'accept'], true)); ?>">
    <div id="page-actions">
        <?php // With nothing to change, there's nothing to accept; Back ends the review as Cancel does. ?>
        <button type="submit" class="button" formaction="<?php echo $escape($this->url(null, ['action' => 'cancel'], true)); ?>"><?php echo (null !== $diff && !$changes) ? $translate('Back') : $translate('Cancel'); ?></button>
        <?php if ($changes): ?>
        <button type="submit"><?php echo $translate('Accept changes'); ?></button>
        <?php endif; ?>
    </div>
    <input type="hidden" name="review" value="<?php echo $escape($token); ?>">
    <?php // The import options the changes below were read with, which Accept applies. ?>
    <input type="hidden" name="lang" value="<?php echo $escape($lang); ?>">
    <input type="hidden" name="comments" value="<?php echo $escape($comments); ?>">
    <input type="hidden" name="label_property" value="<?php echo $escape($otherLabelProperty); ?>">
    <input type="hidden" name="comment_property" value="<?php echo $escape($otherCommentProperty); ?>">
    <?php foreach ($form->getElements() as $element): ?>
    <?php if ($element instanceof \Laminas\Form\Element\Csrf): ?>
    <?php echo $this->formHidden($element); ?>
    <?php endif; ?>
    <?php endforeach; ?>
</form>

<?php // The choices, as rows like core's form rows. ?>
<form method="get" action="<?php echo $escape($this->url(null, [], true)); ?>" class="review-choices">
    <input type="hidden" name="review" value="<?php echo $escape($token); ?>">
    <?php if ($languages || '' !== $lang): ?>
    <div class="field">
        <div class="field-meta">
            <label for="review-lang"><?php echo $translate('Preferred language'); ?></label>
            <a href="#" class="expand" aria-expanded="false" aria-controls="review-lang-description" aria-label="<?php echo $escape($translate('Expand')); ?>"></a>
            <div class="collapsible" id="review-lang-description">
                <div class="field-description"><?php echo $translate('The language to read labels and comments in, where the file has them in several.'); ?></div>
            </div>
        </div>
        <div class="inputs">
            <select name="lang" id="review-lang">
                <option value=""<?php echo '' === $lang ? ' selected' : ''; ?>><?php echo $translate('First available'); ?></option>
                <?php foreach (array_unique(array_merge($languages, '' === $lang ? [] : [$lang])) as $tag): ?>
                <?php $name = extension_loaded('intl') ? \Locale::getDisplayName($tag) : $tag; ?>
                <option value="<?php echo $escape($tag); ?>"<?php echo $lang === $tag ? ' selected' : ''; ?>><?php echo $escape($name === $tag ? $tag : sprintf('%s (%s)', $name, $tag)); ?></option>
                <?php endforeach; ?>
            </select>
        </div>
    </div>
    <?php endif; ?>
    <div class="field">
        <div class="field-meta">
            <label for="review-comments"><?php echo $translate('Comments'); ?></label>
            <a href="#" class="expand" aria-expanded="false" aria-controls="review-comments-description" aria-label="<?php echo $escape($translate('Expand')); ?>"></a>
            <div class="collapsible" id="review-comments-description">
                <div class="field-description"><?php echo $translate('A term\'s comment is read from its comment (rdfs:comment) or its definition (skos:definition, dcterms:description, or dc11:description), whichever it has. Choose which comes first for a term that has both, or another property.'); ?></div>
            </div>
        </div>
        <div class="inputs">
            <select name="comments" id="review-comments" data-other-property="#review-comment-property">
                <option value="comment"<?php echo 'comment' === $comments ? ' selected' : ''; ?>><?php echo $translate('Comment, else definition'); ?></option>
                <option value="definition"<?php echo 'definition' === $comments ? ' selected' : ''; ?>><?php echo $translate('Definition, else comment'); ?></option>
                <option value="other"<?php echo 'other' === $comments ? ' selected' : ''; ?>><?php echo $translate('Another property…'); ?></option>
            </select>
        </div>
    </div>
    <div class="field">
        <div class="field-meta">
            <label for="review-comment-property"><?php echo $translate('Comment property'); ?></label>
            <a href="#" class="expand" aria-expanded="false" aria-controls="review-comment-property-description" aria-label="<?php echo $escape($translate('Expand')); ?>"></a>
            <div class="collapsible" id="review-comment-property-description">
                <div class="field-description"><?php echo $translate('Enter the property each term\'s comment is read from. Please use the full property URI enclosed in angle brackets.'); ?></div>
            </div>
        </div>
        <div class="inputs">
            <input type="text" name="comment_property" id="review-comment-property" value="<?php echo $escape($otherCommentProperty); ?>">
        </div>
    </div>
    <div class="field">
        <div class="field-meta">
            <label for="review-label-property"><?php echo $translate('Label property'); ?></label>
            <a href="#" class="expand" aria-expanded="false" aria-controls="review-label-property-description" aria-label="<?php echo $escape($translate('Expand')); ?>"></a>
            <div class="collapsible" id="review-label-property-description">
                <div class="field-description"><?php echo $translate('Enter the label property. This is typically only needed if the vocabulary uses an unconventional property for labels. Please use the full property URI enclosed in angle brackets.'); ?></div>
            </div>
        </div>
        <div class="inputs">
            <input type="text" name="label_property" id="review-label-property" value="<?php echo $escape($otherLabelProperty); ?>">
        </div>
    </div>
    <div class="review-choices-actions">
        <button type="submit"><?php echo $translate('Show changes'); ?></button>
    </div>
</form>

<?php if (null !== $diff): ?>
<?php if ($changes): ?>
<p><?php echo sprintf($translate('Accepting makes the changes below, from %s. It removes nothing.'), $escape($sourceLabel)); ?></p>
<?php else: ?>
<p><?php echo sprintf($translate('This vocabulary already matches %s.'), $escape($sourceLabel)); ?></p>
<?php endif; ?>
<?php endif; ?>

<?php if ($namespaceChanges): ?>
<h2><?php echo $translate('Vocabulary'); ?></h2>
<table class="tablesaw review-table review-changes" data-tablesaw-mode="stack">
    <thead>
        <tr>
            <th><?php echo $translate('Field'); ?></th>
            <th><?php echo $translate('From'); ?></th>
            <th><?php echo $translate('To'); ?></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td role="rowheader"><?php echo $escape($translate('Namespace URI')); ?></td>
            <td><?php echo $value($vocabulary->namespaceUri()); ?></td>
            <td><?php echo $value($review['new_namespace_uri']); ?></td>
        </tr>
    </tbody>
</table>
<p><?php echo $translate('Changing the namespace changes the URI of every class and property in this vocabulary. Nothing is deleted.'); ?></p>
<?php endif; ?>

<?php if (count($sections) > 1): ?>
<nav class="review-sections" aria-label="<?php echo $escape($translate('Sections')); ?>">
    <ul>
        <?php foreach ($sections as $section): ?>
        <li><a href="#<?php echo $section['id']; ?>"><?php echo $escape(sprintf('%s (%s)', $section['heading'], count($section['rows']))); ?></a></li>
        <?php endforeach; ?>
    </ul>
</nav>
<?php endif; ?>

<?php foreach ($sections as $section): ?>
<h2 id="<?php echo $section['id']; ?>" tabindex="-1"><?php echo $escape(sprintf('%s (%s)', $section['heading'], count($section['rows']))); ?></h2>
<?php if (isset($section['note'])): ?>
<p><?php echo $section['note']; ?></p>
<?php endif; ?>
<table class="tablesaw review-table <?php echo $section['class'] ?? ''; ?>" data-tablesaw-mode="stack">
    <thead>
        <tr>
            <?php foreach ($section['columns'] as $column): ?>
            <th><?php echo $escape($column); ?></th>
            <?php endforeach; ?>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($section['rows'] as $row): ?>
        <tr>
            <?php // The term heads its row, so a screen reader names it with each value. ?>
            <?php foreach ($row as $i => $cell): ?>
            <td<?php echo 0 === $i ? ' role="rowheader"' : ''; ?>><?php echo $cell; ?></td>
            <?php endforeach; ?>
        </tr>
        <?php endforeach; ?>
    </tbody>
</table>
<?php endforeach; ?>
