# The tests' vocabulary's property in another form of its namespace URI,
# https for http, with its label changed.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix review: <https://example.org/review#> .

review:name a rdf:Property ;
    rdfs:label "Changed" ;
    rdfs:comment "<i>stored property comment</i>" .
