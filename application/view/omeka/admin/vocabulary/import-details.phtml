<?php
$this->headScript()->appendFile($this->assetUrl('js/vocabulary-form.js', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'vocabularies import-details');
$translate = $this->plugin('translate');
$form->prepare();
// Say the file gives no namespace URI only while its field is empty: after
// a refused import, the field shows what the admin entered.
$info = $form->get('vocabulary-info');
$asksNamespaceUri = null === $details['namespace_uri'] && '' === trim((string) $info->get('o:namespace_uri')->getValue());

// The classes and properties importing adds, in sections like a review's.
$sections = null === $members ? [] : array_filter([
    ['id' => 'import-classes', 'heading' => $translate('Classes'), 'columns' => [$translate('Class'), $translate('Label'), $translate('Comment')], 'terms' => $members['classes'], 'count' => count($members['classes'])],
    ['id' => 'import-properties', 'heading' => $translate('Properties'), 'columns' => [$translate('Property'), $translate('Label'), $translate('Comment')], 'terms' => $members['properties'], 'count' => count($members['properties'])],
], fn ($section) => (bool) $section['count']);
?>

<?php echo $this->pageTitle($translate('New vocabulary'), 1, $translate('Vocabularies'), $translate('Details')); ?>

<?php echo $this->form()->openTag($form); ?>
<div id="page-actions">
    <?php // To the list the import started from. The file stays in the file store until it's cleared out, after a day. ?>
    <?php echo $this->hyperlink($translate('Cancel'), $this->url('admin/default', ['controller' => 'vocabulary', 'action' => 'browse']), ['class' => 'button']); ?>
    <button><?php echo $translate('Import'); ?></button>
    <?php if ($updatable): ?>
    <?php // After Import, which Enter in a field still means. Starts Update's review with this file, ending the import. ?>
    <button type="submit" name="update" value="1" formnovalidate><?php echo $translate('Review changes'); ?></button>
    <?php endif; ?>
</div>
<?php if ($asksNamespaceUri): ?>
<p><?php echo $translate('The file doesn\'t give a namespace URI for its classes and properties. Enter it below.'); ?></p>
<?php endif; ?>
<?php echo $this->formCollection($info, false); ?>
<?php // Under its label, as the review's choices are. ?>
<?php echo $this->formCollection($form->get('vocabulary-advanced')); ?>
<?php echo $this->formRow($form->get('csrf')); ?>
<div class="review-choices-actions">
    <?php // Posts the form to show the classes and properties again, without importing. ?>
    <button type="submit" name="preview" value="1" formnovalidate><?php echo $translate('Show classes and properties'); ?></button>
    <?php // Shown by the script once a field the list below depends on changes. ?>
    <p class="review-stale" role="status" data-watch="fieldset :input, [name='vocabulary-info[o:namespace_uri]'], [name='vocabulary-info[o:prefix]']" hidden><?php echo $translate('The fields above have changed. Click Show classes and properties to see the result.'); ?></p>
</div>
<?php echo $this->form()->closeTag(); ?>

<?php echo $this->partial('omeka/admin/vocabulary/review-sections', ['sections' => $sections, 'prefix' => trim((string) $info->get('o:prefix')->getValue())]); ?>
