{
    "name": "omeka/omeka-assets",
    "type": "composer-plugin",
    "version": "1.0.0",
    "description": "Composer plugin to download external assets for Omeka S modules and themes",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Omeka\\OmekaAssets\\": "src/"
        }
    },
    "extra": {
        "class": "Omeka\\OmekaAssets\\OmekaAssetsPlugin"
    }
}
