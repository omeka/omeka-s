{
    "name": "omeka/composer-addon-installer",
    "version": "3.0",
    "description": "Composer plugin to install Omeka S modules and themes into addons/modules/ and addons/themes/.",
    "type": "composer-plugin",
    "license": "GPL-3.0",
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Omeka\\Composer\\": "src/"
        }
    },
    "extra": {
        "class": "Omeka\\Composer\\AddonInstallerPlugin"
    }
}
