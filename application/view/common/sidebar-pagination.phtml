<?php
$translate = $this->plugin('translate');
?>
<nav class="pagination" aria-label="<?php echo $translate('Pagination'); ?>">
    <form method="GET" action="">
        <div class="pagination-input-form">
            <input type="text" name="page" class="page-input-top" value="<?php echo $currentPage; ?>" size="4" data-pagination-url="<?php echo $this->escapeHtml($pagelessUrl); ?>" <?php echo ($pageCount == 1) ? 'readonly' : ''; ?> aria-label="<?php echo $translate('Page'); ?>">
            <span class="page-count"><?php echo sprintf($translate('of %s'), $pageCount); ?></span>
        </div>
    </form>

    <div class="pagination-buttons">
        <?php if ($currentPage != 1): ?>
        <button type="button" class="previous o-icon-prev button has-tooltip" data-sidebar-content-url="<?php echo $previousPageUrl; ?>" aria-label="<?php echo $translate('Previous'); ?>" title="<?php echo $translate('Previous'); ?>"></button>
        <?php else: ?>
        <span class="previous o-icon-prev button inactive" aria-hidden="true"></span>
        <?php endif; ?>

        <?php if ($currentPage < $pageCount): ?>
        <button type="button" class="next o-icon-next button has-tooltip" data-sidebar-content-url="<?php echo $nextPageUrl; ?>" aria-label="<?php echo $translate('Next'); ?>" title="<?php echo $translate('Next'); ?>"></button>
        <?php else: ?>
        <span class="next o-icon-next button inactive" aria-hidden="true"></span>
        <?php endif; ?>
    </div>

    <?php
    $from = $offset + 1;
    $to = ($currentPage < $pageCount) ? $offset + $perPage : $totalCount;
    ?>
    <span class="row-count"><?php echo sprintf('%s–%s of %s', $from, $to, $totalCount); ?></span>
</nav>
