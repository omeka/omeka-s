# The tests' vocabulary in another namespace, with its property's label
# changed.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix moved: <http://example.org/moved#> .

moved:name a rdf:Property ;
    rdfs:label "Changed" ;
    rdfs:comment "<i>stored property comment</i>" .
