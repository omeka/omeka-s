<?php // Deleting takes every value of its properties, so the confirmation, loaded into this, says how much. ?>
<div id="delete" class="sidebar">
    <?php echo $this->hyperlink('', '#', ['class' => 'sidebar-close o-icon-close', 'title' => $translate('Close')]); ?>
