<?php
$translate = $this->plugin('translate');
// In the delete confirmation, the counts say what deleting does.
$deleting = !empty($this->deleting);
?>
<h3><?php echo $this->escapeHtml($translate($resource->label())); ?></h3>
<div class="o-description"><?php echo $this->escapeHtml($translate($resource->comment())); ?></div>
<div class="meta-group">
    <h4><?php echo $translate('Namespace URI:'); ?></h4>
    <div class="value"><?php echo $this->escapeHtml($resource->namespaceUri()); ?></div>
</div>
<div class="meta-group">
    <h4><?php echo $deleting ? $translate('Values deleted') : $translate('Values'); ?></h4>
    <div class="value"><?php echo $resource->valueCount(); ?></div>
</div>
<div class="meta-group">
    <h4><?php echo $deleting ? $translate('Resource template properties deleted') : $translate('Resource template properties'); ?></h4>
    <div class="value"><?php echo $resource->resourceTemplatePropertyCount(); ?></div>
</div>
<div class="meta-group">
    <h4><?php echo $deleting ? $translate('Resources left without a class') : $translate('Resources with its classes'); ?></h4>
    <div class="value"><?php echo $resource->resourceWithClassCount(); ?></div>
</div>
<?php $this->trigger('view.details', ['entity' => $resource]); ?>
