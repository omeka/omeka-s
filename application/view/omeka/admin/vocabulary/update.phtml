<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$this->htmlElement('body')->appendAttribute('class', 'vocabularies update');
$typeLabels = [
    'label' => $translate('Label'),
    'comment' => $translate('Comment'),
];
$changedProperties = [];
foreach ($diff['properties']['label'] as $localName => $change) {
    $changedProperties[] = ['label', $localName, $change];
}
foreach ($diff['properties']['comment'] as $localName => $change) {
    $changedProperties[] = ['comment', $localName, $change];
}

$changedClasses = [];
foreach ($diff['classes']['label'] as $localName => $change) {
    $changedClasses[] = ['label', $localName, $change];
}
foreach ($diff['classes']['comment'] as $localName => $change) {
    $changedClasses[] = ['comment', $localName, $change];
}
?>
<?php echo $this->pageTitle($vocabulary->label(), 1, $translate('Vocabularies'), $translate('Update')); ?>
<?php echo $this->form()->openTag($form); ?>
<div id="page-actions">
    <a href="<?php echo $this->escapeHtml($this->url('admin/default', ['action' => 'browse'], true)); ?>" class="button"><?php echo $translate('Cancel'); ?></a>
    <button><?php echo $translate('Accept changes'); ?></button>
</div>
<?php echo $this->formCollection($form, false); ?>
<?php echo $this->form()->closeTag(); ?>

<h3><?php echo $translate('Changed Properties'); ?></h3>
<?php if ($changedProperties): ?>
<table class="tablesaw" data-tablesaw-mode="stack">
<thead>
    <tr>
        <th><?php echo $translate('Local name'); ?></th>
        <th><?php echo $translate('Type'); ?></th>
        <th><?php echo $translate('From'); ?></th>
        <th><?php echo $translate('To'); ?></th>
    </tr>
</thead>
<tbody>
    <?php foreach ($changedProperties as $changedProperty): ?>
    <tr>
        <td><?php echo $escape($changedProperty[1]); ?></td>
        <td><?php echo $typeLabels[$changedProperty[0]]; ?></td>
        <td><?php echo $escape($changedProperty[2][0]); ?></td>
        <td><?php echo $escape($changedProperty[2][1]); ?></td>
    </tr>
    <?php endforeach; ?>
</tbody>
</table>
<?php else: ?>
<p><?php echo $translate('No changed properties found.'); ?></p>
<?php endif; ?>

<h3><?php echo $translate('Changed Classes'); ?></h3>
<?php if ($changedClasses): ?>
<table class="tablesaw" data-tablesaw-mode="stack">
